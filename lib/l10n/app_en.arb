{
  "@@locale": "en",

  "titleActivityRsgMain": "Random Sequence Generator",
  "@titleActivityRsgMain": {
    "description": "Title of the main screen."
  },

  "sectionMode": "Mode",
  "@sectionMode": {
    "description": "Heading of the section that picks how the sequence is generated on the main screen, and of the mode of a saved sequence on the screen showing one."
  },
  "sectionName": "Name",
  "@sectionName": {
    "description": "Heading of the name a saved sequence was stored under, on the screen showing one."
  },
  "sectionSaved": "Saved",
  "@sectionSaved": {
    "description": "Heading of when a saved sequence was stored, on the screen showing one."
  },
  "savedAt": "{date} at {time}",
  "@savedAt": {
    "description": "When a saved sequence was stored: a date and a time of day. The time uses whatever clock the locale prefers, 12- or 24-hour.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "yMMMd",
        "example": "Jul 31, 2026"
      },
      "time": {
        "type": "DateTime",
        "format": "jm",
        "example": "14:05"
      }
    }
  },
  "sectionValue": "Value",
  "@sectionValue": {
    "description": "Heading of the sequence itself, on the screen showing one saved sequence."
  },
  "sectionOptions": "Options",
  "@sectionOptions": {
    "description": "Heading of the section holding the settings of the selected generation mode."
  },

  "rBinary": "Binary",
  "@rBinary": {
    "description": "Generation mode: the pool is 0 and 1."
  },
  "rHexadecimal": "Hexadecimal",
  "@rHexadecimal": {
    "description": "Generation mode: the pool is 0-9 and A-F."
  },
  "rClass": "Class",
  "@rClass": {
    "description": "Generation mode: the pool is built from the checked character classes."
  },
  "rManual": "Manual",
  "@rManual": {
    "description": "Generation mode: the pool is whatever the user types."
  },
  "rUuid": "UUID/GUID",
  "@rUuid": {
    "description": "Generation mode: a version 4 UUID, also known as a GUID. Both acronyms are usually left untranslated."
  },

  "rMask": "Mask",
  "@rMask": {
    "description": "Generation mode: the user writes a template and each placeholder in it is filled at random."
  },

  "uuidUppercase": "Uppercase",
  "@uuidUppercase": {
    "description": "Checkbox that renders the UUID's hexadecimal digits in capitals."
  },
  "uuidHyphens": "Hyphens",
  "@uuidHyphens": {
    "description": "Checkbox that separates the five UUID groups with hyphens."
  },
  "uuidBraces": "Braces",
  "@uuidBraces": {
    "description": "Checkbox that wraps the UUID in curly braces, the Microsoft GUID style."
  },

  "maskHint": "AA###AA",
  "@maskHint": {
    "description": "Placeholder in the mask field, an example mask that generates a car plate."
  },
  "maskLegendTitle": "How to write a mask",
  "@maskLegendTitle": {
    "description": "Heading of the block that explains the mask syntax."
  },
  "maskTokenDigit": "a digit, 0 to 9",
  "@maskTokenDigit": {
    "description": "Legend entry for the mask placeholder that generates one digit."
  },
  "maskTokenLowercase": "a lowercase letter",
  "@maskTokenLowercase": {
    "description": "Legend entry for the mask placeholder that generates one lowercase letter."
  },
  "maskTokenUppercase": "an uppercase letter",
  "@maskTokenUppercase": {
    "description": "Legend entry for the mask placeholder that generates one uppercase letter."
  },
  "maskTokenLetter": "a letter, either case",
  "@maskTokenLetter": {
    "description": "Legend entry for the mask placeholder that generates one letter of either case."
  },
  "maskTokenAlphanumeric": "a letter or a digit",
  "@maskTokenAlphanumeric": {
    "description": "Legend entry for the mask placeholder that generates one letter or digit."
  },
  "maskTokenHexLower": "a lowercase hex digit, 0 to f",
  "@maskTokenHexLower": {
    "description": "Legend entry for the mask placeholder that generates one lowercase hexadecimal digit."
  },
  "maskTokenHexUpper": "an uppercase hex digit, 0 to F",
  "@maskTokenHexUpper": {
    "description": "Legend entry for the mask placeholder that generates one uppercase hexadecimal digit."
  },
  "maskTokenSpecial": "a special character",
  "@maskTokenSpecial": {
    "description": "Legend entry for the mask placeholder that generates one special character."
  },
  "maskTokenRepeat": "repeats the item before it, five times here",
  "@maskTokenRepeat": {
    "description": "Legend entry for the mask repetition count, shown next to the syntax a{5}. Braces cannot appear in this text because they are ICU placeholder syntax."
  },
  "maskTokenEscape": "the next character exactly as typed",
  "@maskTokenEscape": {
    "description": "Legend entry for the mask escape character, a backslash."
  },
  "maskLiteralNote": "Anything else is copied as it is, so AA-### keeps the dash.",
  "@maskLiteralNote": {
    "description": "Legend note explaining that unrecognized mask characters are literals."
  },
  "maskExample": "Example: AA###AA generates a plate like QP417XZ",
  "@maskExample": {
    "description": "Worked example closing the mask legend."
  },
  "maskErrorNoPlaceholder": "Add at least one placeholder, like AA###AA",
  "@maskErrorNoPlaceholder": {
    "description": "Error shown under the mask field when the mask is empty or made of literals only."
  },
  "maskErrorQuantifier": "A repetition needs an item before it and a number inside the braces",
  "@maskErrorQuantifier": {
    "description": "Error shown under the mask field when a repetition count is malformed. Braces cannot appear in this text because they are ICU placeholder syntax."
  },
  "maskErrorTooLong": "The mask would generate more than {max} characters",
  "@maskErrorTooLong": {
    "description": "Error shown under the mask field when the mask expands past the maximum length.",
    "placeholders": {
      "max": {
        "type": "int",
        "example": "4096"
      }
    }
  },

  "rangeDigit": "[0–9]",
  "@rangeDigit": {
    "description": "Label of the digits checkbox. The dash is U+2013 EN DASH."
  },
  "rangeLowercase": "[a–z]",
  "@rangeLowercase": {
    "description": "Label of the lowercase letters checkbox. The dash is U+2013 EN DASH."
  },
  "rangeUppercase": "[A–Z]",
  "@rangeUppercase": {
    "description": "Label of the uppercase letters checkbox. The dash is U+2013 EN DASH."
  },
  "rangeSpecial": "[$%&()=?@#<>_£[]*]",
  "@rangeSpecial": {
    "description": "Label of the special characters checkbox, listing the characters themselves."
  },

  "manualHint": "abcd078[]",
  "@manualHint": {
    "description": "Placeholder in the manual character pool field, an example pool."
  },
  "create": "Create",
  "@create": {
    "description": "Button that generates a new sequence."
  },
  "length": "Length",
  "@length": {
    "description": "Label of the sequence length field."
  },

  "copy": "Copy",
  "@copy": {
    "description": "Action that copies the sequence to the clipboard."
  },
  "copiedToCb": "Copied to clipboard",
  "@copiedToCb": {
    "description": "Confirmation shown after copying a sequence."
  },
  "send": "Share",
  "@send": {
    "description": "Action that opens the system share sheet. The key is the legacy name of the Android intent; the label is what the system sheet is actually called."
  },
  "view": "View",
  "@view": {
    "description": "Tooltip of the eye button on a saved row, which opens the screen showing that sequence."
  },
  "save": "Save",
  "@save": {
    "description": "Action that stores the sequence under a name."
  },
  "cancel": "Cancel",
  "@cancel": {
    "description": "Dismisses a dialog without acting."
  },
  "saveAs": "Save as…",
  "@saveAs": {
    "description": "Message of the save dialog. Ends with U+2026 HORIZONTAL ELLIPSIS."
  },
  "saved": "Saved",
  "@saved": {
    "description": "App bar action that opens the saved sequences screen."
  },
  "saveHint": "Enter a name",
  "@saveHint": {
    "description": "Placeholder in the save dialog's name field."
  },

  "titleActivityShowSaved": "Saved Sequences",
  "@titleActivityShowSaved": {
    "description": "Title of the saved sequences list screen."
  },
  "noSaved": "No saved entries",
  "@noSaved": {
    "description": "Empty state of the saved sequences list."
  },
  "selectAll": "Select all",
  "@selectAll": {
    "description": "Action that selects every saved sequence, shown while a selection is in progress."
  },
  "selectedCount": "{count, plural, =1{1 selected} other{{count} selected}}",
  "@selectedCount": {
    "description": "Title of the saved sequences screen while a selection is in progress, counting the selected entries.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "delete": "Delete",
  "@delete": {
    "description": "Removes saved sequences: the entry's own action and its confirming button, the button on the single sequence screen, and the app bar action that removes the current selection."
  },
  "deleteEntryMessage": "Delete \"{name}\"?",
  "@deleteEntryMessage": {
    "description": "Message of the dialog confirming the removal of one saved sequence, from that entry's own actions.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "my key"
      }
    }
  },
  "deleteEntriesMessage": "{count, plural, =1{Delete 1 entry?} other{Delete {count} entries?}}",
  "@deleteEntriesMessage": {
    "description": "Message of the dialog confirming the removal of several saved sequences at once: the selected ones, or all of them.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "titleActivityShowSingle": "Show Sequences",
  "@titleActivityShowSingle": {
    "description": "Title of the screen that displays one saved sequence."
  },

  "coin": "Coin",
  "@coin": {
    "description": "App bar action that opens the coin flip screen."
  },
  "titleActivityLaunchCoin": "Launch Coin",
  "@titleActivityLaunchCoin": {
    "description": "Title of the coin flip screen."
  },
  "flip": "Flip",
  "@flip": {
    "description": "Button that starts a coin flip."
  },
  "clickOnFlip": "Click on flip",
  "@clickOnFlip": {
    "description": "Hint shown in the coin area before the first flip."
  },

  "lengthInvalid": "Enter a number between {min} and {max}",
  "@lengthInvalid": {
    "description": "Error shown under the length field when the value is missing or out of range.",
    "placeholders": {
      "min": {
        "type": "int",
        "example": "1"
      },
      "max": {
        "type": "int",
        "example": "4096"
      }
    }
  },
  "nameRequired": "Enter a name",
  "@nameRequired": {
    "description": "Error shown in the save dialog when the name is blank."
  },
  "overwriteTitle": "Overwrite?",
  "@overwriteTitle": {
    "description": "Title of the dialog shown when saving over an existing name."
  },
  "overwriteMessage": "\"{name}\" already exists. Replace it?",
  "@overwriteMessage": {
    "description": "Message of the overwrite confirmation dialog.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "my key"
      }
    }
  },
  "replace": "Replace",
  "@replace": {
    "description": "Confirming button of the overwrite dialog."
  },
  "entrySaved": "Saved as \"{name}\"",
  "@entrySaved": {
    "description": "Confirmation shown after storing a sequence.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "my key"
      }
    }
  },
  "emptyPool": "Select at least one character set",
  "@emptyPool": {
    "description": "Shown when Create is pressed with no characters to draw from."
  },
  "entryDeleted": "Deleted \"{name}\"",
  "@entryDeleted": {
    "description": "Confirmation shown after removing one saved sequence.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "my key"
      }
    }
  },
  "entriesDeleted": "{count, plural, =1{Deleted 1 entry} other{Deleted {count} entries}}",
  "@entriesDeleted": {
    "description": "Confirmation shown after removing several saved sequences at once: the selected ones, or all of them.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "changeNotStored": "Storage is unavailable — this change will be lost when the app restarts",
  "@changeNotStored": {
    "description": "Shown in place of the confirmation when a save or a delete could not be written to disk. The change is still applied on screen, which is why the wording is about the restart rather than about the action failing. The dash is U+2014 EM DASH."
  }
}

<?xml version="1.0" encoding="utf-8"?>
<!--
  The saved sequences are generated secrets held in plaintext SharedPreferences.
  They must never leave the device via auto-backup or device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
